{
  "FileProcessing": {
    "MaximumFileSizeBytes": 5242880,
    "MaximumRecordCount": 10000,
    "TrackingHistoryLimit": 100,
    "CsvSupport": {
      "IsEnabled": true,
      "CalculateAverageInColumnName": "Amount"
    },
    "JsonSupport": {
      "IsEnabled": false,
      "FilterIsActiveEquals": true,
      "FilterAmountGreaterThanOrEqualTo": 0,
      "FilterAmountLessThanOrEqualTo": null
    }
  },
  "Swagger": {
    "IsEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
