{
  "Authentication": {
    "Options": "SharedKey|ManagedClientKeys",
    "Mode": "SharedKey",
    "HeaderName": "X-Api-Key",
    "ManagedClientKeysSettings": {
      "RequireExpiration": true,
      "DefaultLifetimeDays": 90,
      "MaximumLifetimeDays": 365,
      "RotationOverlapDays": 7,
      "MaximumActiveKeysPerClient": 2
    }
  },
  "FileProcessing": {
    "MaximumFileSizeBytes": 5242880,
    "MaximumRecordCount": 10000,
    "TrackingHistoryLimit": 100,
    "CsvSupport": {
      "IsEnabled": true,
      "CalculateAverageInColumnName": "Amount"
    },
    "JsonSupport": {
      "IsEnabled": false,
      "FilterIsActiveEquals": true,
      "FilterAmountGreaterThanOrEqualTo": 0,
      "FilterAmountLessThanOrEqualTo": null
    }
  },
  "RateLimiting": {
    "PermitLimit": 20,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Swagger": {
    "IsEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
